bot/cache/
/.tmp/
/.tmp_*/
/tmp/
/temp/
*.tmp
*.log
*.sqlite
*.sqlite3

# Build and packaging artifacts
build/
dist/
*.egg-info/

# IDE and editor settings
.idea/
.vscode/
*.code-workspace
*.swp
*.swo

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

